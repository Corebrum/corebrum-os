[
{
  "layer": "top",
  "position": "top",
  "height": 34,
  "spacing": 8,
  "modules-left": ["sway/workspaces"],
  "modules-center": ["sway/window"],
  "modules-right": ["cpu", "memory", "pulseaudio", "battery", "custom/cloud", "tray", "clock"],
  "sway/workspaces": {
    "format": "{name}",
    "all-outputs": true,
    "persistent-workspaces": {
      "1": [],
      "2": [],
      "3": [],
      "4": [],
      "5": []
    }
  },
  "sway/window": {
    "max-length": 48
  },
  "clock": {
    "format": "{:%Y-%m-%d %H:%M}"
  },
  "cpu": {
    "format": "cpu {usage}%"
  },
  "memory": {
    "format": "mem {percentage}%"
  },
  "pulseaudio": {
    "format": "{icon} {volume}%",
    "format-muted": "🔇 muted",
    "format-bluetooth": "{icon} {volume}%",
    "scroll-step": 5,
    "on-click": "pavucontrol",
    "format-icons": {
      "headphone": "🎧",
      "headset": "🎧",
      "hands-free": "🎧",
      "hdmi": "📺",
      "default": ["🔈", "🔉", "🔊"]
    }
  },
  "battery": {
    "format": "{icon} {capacity}%",
    "format-charging": "{icon} {capacity}%",
    "format-plugged": "{icon} {capacity}%",
    "states": {
      "warning": 30,
      "critical": 15
    },
    "format-icons": {
      "charging": "🔌",
      "plugged": "🔌",
      "default": ["🪫", "🔋", "🔋", "🔋", "🔋"]
    }
  },
  "tray": {
    "spacing": 8
  },
  "custom/cloud": {
    "exec": "/usr/local/bin/corebrum-synapse-status",
    "return-type": "json",
    "interval": 5,
    "on-click": "/usr/local/bin/corebrum-synapse-status click",
    "format": "Cloud",
    "tooltip": true
  }
},
{
  "name": "tagline",
  "layer": "bottom",
  "position": "bottom",
  "height": 32,
  "exclusive": false,
  "passthrough": true,
  "margin-bottom": 16,
  "modules-center": ["custom/tagline"],
  "custom/tagline": {
    "format": "Corebrum: The Physical AI Operating System",
    "tooltip": false
  }
}
]
