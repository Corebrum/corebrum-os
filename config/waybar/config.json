[
{
  "layer": "top",
  "position": "top",
  "height": 34,
  "spacing": 8,
  "modules-left": ["sway/workspaces"],
  "modules-center": ["sway/window"],
  "modules-right": ["cpu", "memory", "network", "pulseaudio", "battery", "custom/agenticros", "tray", "clock"],
  "sway/workspaces": {
    "format": "{name}",
    "all-outputs": true,
    "persistent-workspaces": {
      "1": [],
      "2": [],
      "3": [],
      "4": [],
      "5": []
    }
  },
  "sway/window": {
    "max-length": 48
  },
  "clock": {
    "format": "{:%Y-%m-%d %H:%M}"
  },
  "cpu": {
    "format": "cpu {usage}%"
  },
  "memory": {
    "format": "mem {percentage}%"
  },
  "network": {
    "format-ethernet": "{ifname}",
    "format-wifi": "{essid}",
    "format-disconnected": "offline",
    "tooltip-format": "{ifname}"
  },
  "pulseaudio": {
    "format": "{volume}%",
    "format-muted": "muted",
    "scroll-step": 5,
    "on-click": "pavucontrol"
  },
  "battery": {
    "format": "{capacity}%",
    "format-charging": "{capacity}%",
    "states": {
      "warning": 30,
      "critical": 15
    }
  },
  "tray": {
    "spacing": 8
  },
  "custom/agenticros": {
    "exec": "/usr/local/bin/corebrum-agenticros-status",
    "return-type": "json",
    "interval": 5,
    "on-click": "/usr/local/bin/corebrum-agenticros-status click",
    "format": "{text}",
    "tooltip": true
  }
},
{
  "name": "tagline",
  "layer": "bottom",
  "position": "bottom",
  "height": 32,
  "exclusive": false,
  "passthrough": true,
  "margin-bottom": 16,
  "modules-center": ["custom/tagline"],
  "custom/tagline": {
    "format": "Corebrum: The Physical AI Operating System",
    "tooltip": false
  }
}
]
